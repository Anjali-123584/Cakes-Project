### Get all categories

GET http://127.0.0.1:8000/categories/


### Creating a category

POST http://127.0.0.1:8000/categories/
Content-Type: application/json

{

"name": "Wedding Cakes"
}

### Get a category

GET http://127.0.0.1:8000/categories/1/

### update a category

PATCH http://127.0.0.1:8000/categories/1/
Content-Type: application/json

{
   "name":"Cup Cakes"
}

### delete a category

DELETE  http://127.0.0.1:8000/categories/1/

### Get all weights

GET http://127.0.0.1:8000/weight/

### Creating a weight

POST http://127.0.0.1:8000/weight/
Content-Type: application/json

{
"name" :"Vancho Cake",
"weight": "2.5 kg"
}


### update a weight

PATCH http://127.0.0.1:8000/categories/3/
Content-Type: application/json

{
   "name":"Cup Cakes",
   "weight":"1/2 kg"
}


